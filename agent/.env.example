# WJ-ARGUS — Agent Games (Proof Gatekeeper) environment configuration.
# Copy to .env / export in the shell. NEVER commit a filled-in copy.
# Every value below is EMPTY or a clearly-marked placeholder.

# HMAC SECRET — two ways to provide it, file wins over env:
#   1. PREFERRED: leave this empty and paste the secret ONCE into the
#      agent's own /setup page (https://<public-url>/setup) after
#      deployment. It is stored server-side in data/hmac_secret.txt
#      (mode 600) and the page locks itself. The value never passes
#      through chat.
#   2. FALLBACK: set it here (platform-generated secret from the Agent
#      Games dashboard, shown once at registration).
HMAC_SECRET=

# OPTIONAL. zkVerify Kurier MAINNET API key (from https://kurier.xyz).
# Without it the agent still answers tasks with inline proofs; only the
# background on-chain proof submission via Kurier is skipped.
KURIER_API_KEY=

# OPTIONAL. Kurier REST base URL (default from the official /build examples).
KURIER_API_URL=https://api.kurier.xyz/api/v1

# OPTIONAL. Server port.
PORT=8787

# OPTIONAL. Internal budgets in ms — must stay under the platform's
# 60-second hard response deadline on the REAL host. (On a slow host,
# raise PROOF_TIMEOUT_MS only for local testing, never for live play.)
RESPONSE_DEADLINE_MS=55000
PROOF_TIMEOUT_MS=30000
